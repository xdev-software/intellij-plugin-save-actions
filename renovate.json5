{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Don't manage Java version in actions",
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDatasources": [
        "java-version"
      ],
      "enabled": false
    },
    {
      "description": "Workaround, see https://github.com/gradle/gradle/issues/27035",
      "matchPackagePatterns": [
        "^com.google.guava:guava"
      ],
      "matchDatasources": [
        "maven"
      ],
      "matchCurrentVersion": "0",
      "enabled": false
    },
    {
      "description": "org.jetbrains.intellij.platform - Changelog",
      "packagePattern": "^org.jetbrains.intellij.platform",
      "matchDatasources": [
        "maven"
      ],
      "changelogUrl": "https://github.com/JetBrains/intellij-platform-gradle-plugin/releases"
    }
  ]
}
